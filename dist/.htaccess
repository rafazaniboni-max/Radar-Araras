# O HTML aponta para a revisão diária dos dados. Não guardar uma abertura antiga.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.radarararas\.com\.br$ [NC]
  RewriteRule ^ https://radarararas.com.br%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "-[a-f0-9]{12}\.webp$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|atualizacao\.json)$">
    Header always set Cache-Control "no-store, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
